# Recibo Pro — Environment Variables
# Copy to .env and fill in. Never commit .env.

# Development
NODE_ENV=development

# Windows code signing (required for production distribution)
# CSC_LINK=path/to/certificate.p12
# CSC_KEY_PASSWORD=change-me-certificate-password

# Microsoft Store publisher info (required for appx builds)
# WIN_APPX_PUBLISHER=CN=change-me-publisher-id
