# Normaliza fim de linha: LF no repositório, conversão automática no checkout.
* text=auto eol=lf

# Scripts Windows mantêm CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários — nunca aplicar conversão nem diff textual
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.xlsx binary
*.xls binary
*.rtf binary
